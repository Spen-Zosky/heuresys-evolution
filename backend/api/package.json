{
  "name": "@heuresys/api-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Heuresys Platform API Gateway - REST API service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:unit": "jest --testPathPattern=unit --passWithNoTests",
    "test:integration": "jest --testPathPattern=integration --passWithNoTests"
  },
  "dependencies": {
    "@heuresys/shared": "1.0.0",
    "@sentry/node": "8.55.0",
    "adm-zip": "0.5.16",
    "bcryptjs": "3.0.3",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.3.1",
    "helmet": "8.1.0",
    "ioredis": "5.10.0",
    "jsonwebtoken": "9.0.3",
    "multer": "1.4.5-lts.2",
    "otplib": "13.4.0",
    "papaparse": "5.5.3",
    "pdfkit": "0.17.2",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "rate-limit-redis": "4.3.1",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "uuid": "11.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "1.4.12",
    "@types/node": "20.19.37",
    "@types/papaparse": "5.3.15",
    "@types/pdfkit": "0.17.5",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "eslint": "9.39.4",
    "jest": "29.7.0",
    "nodemon": "3.1.14",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
