# ==============================================================
# Heuresys Evolution — environment template (safe to commit)
# Copy to .env (never committed) and fill actual values.
# ==============================================================

# --- Runtime ---
NODE_ENV=development

# --- API Gateway ---
API_GATEWAY_PORT=3000

# --- Enrichment Engine ---
ENRICHMENT_PORT=8020

# --- Frontend (Next.js) ---
PORT=3012
HOSTNAME=127.0.0.1

# --- PostgreSQL ---
# PGHOST=127.0.0.1
# PGPORT=6432
# PGUSER=heuresys_app
# PGPASSWORD=
# PGDATABASE=heuresys

# --- Redis ---
# REDIS_URL=redis://127.0.0.1:6379

# --- JWT ---
# JWT_SECRET=
# JWT_ISSUER=heuresys-platform

# --- LLM providers (optional) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- E2E test targets ---
E2E_BASE_URL=http://localhost:3012
E2E_API_URL=http://localhost:8012
