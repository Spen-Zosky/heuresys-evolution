{
  "name": "heuresys-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-native HRMS Orchestration Suite for Italian PMI",
  "author": "Heuresys <info@heuresys.com>",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build -w services/api-gateway",
    "build:frontend": "npm run build -w services/frontend",
    "dev": "npm run dev --workspaces --if-present --parallel",
    "dev:api": "npm run dev -w services/api-gateway",
    "dev:frontend": "npm run dev -w services/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "prepare": "husky || true",
    "docker:up": "cd infra && REPOSITORY_DIRECTORY=$(cd .. && pwd) docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "cd infra && docker compose -f docker-compose.dev.yml down",
    "docker:logs": "cd infra && docker compose -f docker-compose.dev.yml logs -f",
    "db:migrate": "echo 'Use SQL migrations in db/migrations/'",
    "db:seed": "echo 'Use SQL seeds in db/seeds/'",
    "db:reset": "echo 'Use direct psql for DB reset'"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.37",
    "bcryptjs": "3.0.3",
    "eslint": "9.39.4",
    "globals": "15.15.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "16.4.0",
    "playwright": "^1.59.1",
    "prettier": "3.8.1",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1"
  },
  "lint-staged": {
    "services/api-gateway/src/**/*.ts": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "services/frontend/src/**/*.{ts,tsx}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "react": "19.2.1",
    "react-dom": "19.2.1"
  }
}
